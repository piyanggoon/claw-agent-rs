# ╔════════════════════════════════════════════════════════════════════╗
# ║  Claw Agent RS — Configuration                                   ║
# ║  Copy to .env and fill in your API key                           ║
# ╚════════════════════════════════════════════════════════════════════╝

# === LLM Provider Keys ===
# At least one API key is required.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# === Model ===
DEFAULT_MODEL=claude-sonnet-4-6

# === Timezone ===
TIMEZONE=Asia/Bangkok

# === Authentication ===
# Set AUTH_ENABLED=1 to require a password for the web UI.
# When disabled (0), all requests are allowed without authentication.
AUTH_ENABLED=0

# The password users must enter to access the web UI.
# Only used when AUTH_ENABLED=1.
# AUTH_PASSWORD=your-secret-password

# Secret key for signing auth tokens (HMAC-SHA256).
# If not set, it is auto-derived from AUTH_PASSWORD as:
#   claw-auth-<AUTH_PASSWORD>-secret-key
# Set this explicitly for production deployments or if you want
# a stronger secret independent of the password.
# AUTH_SECRET=your-random-secret-key-here

# === Web Server ===
# Port for the HTTP API + SSE streaming.
# SoulClaw frontend default: 3100 (set NANOCLAW_API=http://localhost:<port>)
WEB_PORT=3100

# === Paths ===
# DATA_DIR stores the SQLite database and uploaded files (data/uploads/).
DATA_DIR=./data

# GROUPS_DIR contains soul file templates and runtime groups.
GROUPS_DIR=./groups

# MAIN_GROUP is the active agent identity (auto-created from groups/default/).
MAIN_GROUP=main

# === Task Scheduler ===
# How often the scheduler checks for due tasks (seconds).
SCHEDULER_POLL_INTERVAL=15

# Maximum number of tasks running in parallel.
MAX_CONCURRENT_TASKS=3

# Agent execution timeout per run (seconds).
AGENT_TIMEOUT=300

# === Logging ===
# See https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html
RUST_LOG=claw_agent_rs=info,tower_http=info
