# === LLM Provider Keys ===
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# === Claw Configuration ===
DEFAULT_MODEL=claude-sonnet-4-6
TIMEZONE=Asia/Bangkok

# === Server ===
WEB_PORT=3100

# === Paths ===
DATA_DIR=./data
GROUPS_DIR=./groups
MAIN_GROUP=main

# === Scheduler ===
SCHEDULER_POLL_INTERVAL=15
MAX_CONCURRENT_TASKS=3
AGENT_TIMEOUT=300

# === Logging ===
RUST_LOG=claw_agent_rs=info,tower_http=info
